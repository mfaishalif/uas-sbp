{
  "name": "finresolve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FinResolve backend contract generation and test orchestration",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api:validate": "node tools/openapi/validate.mjs",
    "api:generate": "node tools/openapi/generate.mjs",
    "api:check": "node tools/openapi/check.mjs",
    "client:build": "tsc -p packages/api-client/tsconfig.build.json",
    "client:typecheck": "tsc -p packages/api-client/tsconfig.json",
    "client:test": "tsc -p packages/api-client/tsconfig.test.json && node --test packages/api-client/dist-test/test/*.test.js",
    "test:generation": "node --test tools/openapi/generation.test.mjs",
    "test:contract": "npm run client:build && tsc -p tests/contract/tsconfig.json && node --test tests/contract/dist/client.test.js tests/contract/api.test.mjs",
    "eval:split": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"write-split\"",
    "eval:export": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"export-candidates --part calibration\"",
    "eval:select": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"select\"",
    "eval:export-final": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"export-candidates --part final\"",
    "eval:labels": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"validate-labels\"",
    "eval:run": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"evaluate\"",
    "eval:compare": "cd backend && ./mvnw -q -Pevaluation exec:java -Dexec.args=\"compare\"",
    "backend:test": "cd backend && ./mvnw test",
    "backend:package": "cd backend && ./mvnw -DskipTests package",
    "verify": "npm run api:validate && npm run api:check && npm run test:generation && npm run client:typecheck && npm run client:test && npm run backend:test && npm run backend:package && npm run test:contract"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2"
  }
}

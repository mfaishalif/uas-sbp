{
  "name": "FinResolve",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/vscode/.local/state/gh",
    "CODEX_HOME": "/home/vscode/.local/state/codex-home",
    "CODEX_SQLITE_HOME": "/home/vscode/.local/state/codex",
    "OPENCODE_DB": "/home/vscode/.local/state/opencode/opencode.db"
  },
  "mounts": [
    "source=${devcontainerId}-cli-state,target=/home/vscode/.local/state,type=volume",
    "source=${localEnv:USERPROFILE}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:USERPROFILE}/.config/opencode,target=/home/vscode/.config/opencode,type=bind",
    "source=${localEnv:USERPROFILE}/.local/share/opencode,target=/home/vscode/.local/share/opencode,type=bind",
    "source=${localEnv:USERPROFILE}/Pictures/Screenshots,target=/home/vscode/Pictures/Screenshots,type=bind,readonly"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Java backend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postStartCommand": "bash .devcontainer/setup-cli-state.sh",
  "postCreateCommand": "bash .devcontainer/setup-cli-state.sh && node --version && npm --version && java --version && mvn --version && gradle --version && gh --version && codex --version && opencode --version"
}

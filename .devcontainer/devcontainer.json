{
  "name": "FinResolve",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Java backend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "node --version && npm --version && java --version && mvn --version && gradle --version && gh --version && codex --version && opencode --version"
}

{
  "name": "FinResolve",
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "standard"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/vscode/.local/state/gh"
  },
  "mounts": [
    "source=${devcontainerId}-standard-state,target=/home/vscode/.local/state,type=volume"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Java backend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-cli-state.sh standard",
  "postStartCommand": "bash .devcontainer/setup-cli-state.sh standard"
}

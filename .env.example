# Optional Docker host ports. Internal service ports stay 3000 and 8080.
# Copy to .env; Compose loads it automatically from the repository root.
FINRESOLVE_FRONTEND_PORT=13000
FINRESOLVE_API_PORT=18080

# Upstream for the Next.js /api rewrite.
# Docker Compose sets this automatically (http://api:8080).
# For npm development, copy packages/frontend/.env.example to
# packages/frontend/.env.local so Next.js loads it from the app directory.
FINRESOLVE_API_ORIGIN=http://127.0.0.1:8080
